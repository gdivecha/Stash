{
  "client": {
    "baseUrl": "http://localhost:4000/api",
    "version": "v1"
  },
  "snapshot": {
    "includePaths": [
      "~/.zshrc",
      "~/.config/nvim"
    ]
  },
  "restore": {
    "autoOpenVsCode": true,
    "autoOpenBrowserLinks": true,
    "autoSwitchGitBranch": true,
    "autoLaunchTrackedApps": true,
    "suppressPrompts": true,
    "fallbackToDefaultBranch": true
  }
}