{
  "name": "stash",
  "version": "1.0.0",
  "description": "Zero-Effort Developer Workstation Context Engine",
  "type": "module",
  "main": "backend/server.js",
  "bin": {
    "stash": "./client/index.js"
  },
  "scripts": {
    "server:start": "node backend/server.js",
    "server:dev": "nodemon backend/server.js",
    "client:run": "node client/index.js",
    "client:dev": "node --watch client/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:crypto": "node client/tests/crypto.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.1.0"
  }
}
