{
  "name": "stash",
  "version": "1.0.0",
  "description": "Zero-Effort Developer Workstation Context Engine",
  "type": "module",
  "main": "backend/server.js",
  "bin": {
    "stash": "./client/index.js"
  },
  "scripts": {
    "server:start": "node backend/server.js",
    "server:dev": "nodemon backend/server.js",
    "client:run": "node client/index.js",
    "client:dev": "node --watch client/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:crypto": "node client/tests/crypto.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "nodemon": "^3.1.0"
  }
}