            {
              "v": "17",
              "name": "User Sign In",
              "method": "POST",
              "endpoint": "<<baseUrl>>/<<apiVersion>>/auth/sign-in",
              "params": [],
              "headers": [],
              "preRequestScript": "",
              "testScript": "// 1. Extract Set-Cookie header\nconst headers = pw.response.headers || {};\nlet cookieHeader = \"\";\n\nif (Array.isArray(headers)) {\n    const match = headers.find(h => h.key.toLowerCase() === 'set-cookie');\n    if (match) cookieHeader = match.value;\n} else if (typeof headers === 'object') {\n    cookieHeader = headers['set-cookie'] || headers['Set-Cookie'] || \"\";\n}\n\nconst tokenMatch = cookieHeader.match(/token=([^;]+)/);\n\nif (tokenMatch && tokenMatch[1]) {\n    const newToken = tokenMatch[1].trim();\n\n    // 2. Check if a specific slot was requested via Header (e.g. X-User-Slot: 3)\n    const requestedSlot = pw.request.headers['x-user-slot'] || pw.request.headers['X-User-Slot'];\n\n    if (requestedSlot) {\n        const targetVar = `user${requestedSlot}Token`;\n        pw.env.set(targetVar, newToken);\n        console.log(`Forced token save -> <<${targetVar}>>`);\n    } else {\n        // 3. Fallback: Automatically find the next available user slot\n        let targetIndex = 1;\n        let slotFound = false;\n\n        while (!slotFound) {\n            const varName = `user${targetIndex}Token`;\n            const existingVal = pw.env.get(varName);\n\n            if (!existingVal || existingVal === newToken) {\n                pw.env.set(varName, newToken);\n                console.log(`Auto-routed token -> <<${varName}>>`);\n                slotFound = true;\n            } else {\n                targetIndex++;\n            }\n        }\n    }\n\n    // Always set active token for immediate follow-up calls\n    pw.env.set(\"token\", newToken);\n}\n",
              "auth": {
                "authType": "none",
                "authActive": true
              },
