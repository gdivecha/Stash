          "variables": [],
          "description": null,
          "preRequestScript": "",
          "testScript": "console.log(\"--- Post-Request Script Running ---\");\n\nconst resHeaders = pw.response.headers || {};\nlet cookieHeader = \"\";\n\nif (Array.isArray(resHeaders)) {\n    const match = resHeaders.find(h => h && (h.key || h.name || \"\").toLowerCase() === 'set-cookie');\n    if (match) cookieHeader = match.value;\n} else if (typeof resHeaders === 'object') {\n    for (const key in resHeaders) {\n        if (key && key.toLowerCase() === 'set-cookie') {\n            cookieHeader = Array.isArray(resHeaders[key]) ? resHeaders[key].join('; ') : resHeaders[key];\n            break;\n        }\n    }\n}\n\nconst tokenMatch = cookieHeader.match(/token=([^;]+)/);\n\nif (tokenMatch && tokenMatch[1]) {\n    const newToken = tokenMatch[1].trim();\n\n    let responseBodyStr = \"\";\n    try {\n        responseBodyStr = typeof pw.response.body === 'string' ? pw.response.body : JSON.stringify(pw.response.body || {});\n    } catch (e) {\n        responseBodyStr = \"\";\n    }\n\n    let targetSlot = \"1\";\n    const lowerBody = responseBodyStr.toLowerCase();\n\n    if (lowerBody.includes(\"divechagaurav\")) {\n        targetSlot = \"2\";\n    } else if (lowerBody.includes(\"gaurav\")) {\n        targetSlot = \"1\";\n    }\n\n    // Update target slot\n    pw.env.set(\"targetSlot\", targetSlot);\n\n    // Save to slot-specific variable\n    const targetVar = `user${targetSlot}Token`;\n    pw.env.set(targetVar, newToken);\n\n    // Also instantly update the active 'token' variable\n    pw.env.set(\"token\", newToken);\n\n    console.log(`Success! Set targetSlot to ${targetSlot}, saved token to <<${targetVar}>>, and updated active <<token>>.`);\n} else {\n    console.error(\"TOKEN MISSING: Set-Cookie header not found in response.\");\n}"
